# Copy to .env for local runs (uvicorn) against remote/local vLLM servers.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
RESPONDER_MODEL=gemma-cbt
PLANNER_MODEL=google/gemma-2-2b-it

GUARD_BASE_URL=http://localhost:8001/v1
GUARD_API_KEY=EMPTY
GUARD_MODEL=meta-llama/Llama-Guard-3-1B
GUARD_FAIL_CLOSED=true

AGENT_MAX_STEPS=2
CRISIS_REGION=IN

# docker compose only
HF_TOKEN=
